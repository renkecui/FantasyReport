#!/bin/bash
# Blocks a commit if private files or secrets are about to be committed.
blocked='(^|/)(config\.json|credentials\.json|token\.json|sheet_id\.txt|sync_state\.json|update\.log)$|\.xlsx$|^backups/'
bad=$(git diff --cached --name-only | grep -E "$blocked")
if [ -n "$bad" ]; then
  echo "Commit blocked: these files are private and must not be committed:"; echo "$bad"
  echo "Unstage them with:  git restore --staged <file>"; exit 1
fi
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -qE 'ya29\.|"refresh_token"|"client_secret"|"espn_s2": *"[^P"][^"]{30,}'; then
  echo "Commit blocked: a Google token, client secret or ESPN cookie seems to be in the staged changes."; exit 1
fi
