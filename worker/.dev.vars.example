# Copy to .dev.vars for `npm run dev` (git-ignored). Real values are Worker secrets in the Cloudflare dashboard (docs/SETUP.md step 6).
LEAGUE_PASSWORD=change-me
TOKEN_SECRET=any-long-random-text
# For the local preview (docs/PREVIEW.md); scripts/preview.sh creates .dev.vars from these.
LEAGUE_JSON_URL=http://localhost:8765/league.json
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
